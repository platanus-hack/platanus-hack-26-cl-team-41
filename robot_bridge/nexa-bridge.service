[Unit]
Description=Nexa robot bridge (web console <-> arm, drive and vision)
After=network-online.target
Wants=network-online.target

[Service]
# adjust the user and the path to where the repository lives on the Pi
User=pi
WorkingDirectory=/home/pi/SOLIDCRAFT/robot_bridge
ExecStart=/home/pi/SOLIDCRAFT/robot_bridge/.venv/bin/python -m nexa_bridge
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
