[Unit]
Description=Rover: video de la camara girado 180 grados (puerto 8080)
After=network-online.target camara.service
Wants=network-online.target camara.service

[Service]
User=pi
ExecStart=/usr/bin/python3 -u /home/pi/camara_giro.py --grados 180
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
