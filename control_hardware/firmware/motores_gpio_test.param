# Prueba de motores: S7..S10 como GPIO digitales (relays) hacia IN1..IN4 del L298N
# S7=GPIO56 (IN1)  S8=GPIO57 (IN2)  S9=GPIO58 (IN3)  S10=GPIO59 (IN4)
SERVO7_FUNCTION,-1
SERVO8_FUNCTION,-1
SERVO9_FUNCTION,-1
SERVO10_FUNCTION,-1
RELAY1_FUNCTION,1
RELAY2_FUNCTION,1
RELAY3_FUNCTION,1
RELAY4_FUNCTION,1
