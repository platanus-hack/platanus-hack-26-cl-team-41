# Brazo completo estabilizado por scripts/brazo_estable.lua
# Apaga el estabilizador de prueba (Mount en S2/S3) y entrega S2..S6 al script.
MNT1_TYPE,0
# S2 base, S3 hombro, S4 codo, S5 inclinacion muneca, S6 giro muneca (Script1..Script5)
SERVO2_FUNCTION,94
SERVO3_FUNCTION,95
SERVO4_FUNCTION,96
SERVO5_FUNCTION,97
SERVO6_FUNCTION,98
# Segundo servo del hombro (Script7) en S1 (50 Hz, grupo S1-S2). Sin pulso hasta que BRH_DIR = 1 o -1.
SERVO1_FUNCTION,100
# Pinza (Script6) en S11 (grupo S11-S12, 50 Hz). S7..S10 siguen siendo del L298N (490 Hz).
SERVO11_FUNCTION,99
# Segundo servo del codo (Script8) en S12. Sin pulso hasta que BRE_DIR = 1 o -1.
SERVO12_FUNCTION,101
# Postura de reposo cuando no hay puente (grados): base, hombro, codo, muneca, giro. Reposo calibrado (2026-11-22)
SCR_USER2,0
SCR_USER3,-30
SCR_USER4,60
SCR_USER5,50
SCR_USER6,0
SCR_ENABLE,1
